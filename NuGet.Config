<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Managed projects use the framework reference packs supplied by the .NET SDK, plus exactly one package:
       Microsoft.Web.WebView2 (the in-app Roblox login window). Nothing else may come from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.Web.WebView2" />
    </packageSource>
  </packageSourceMapping>
</configuration>
