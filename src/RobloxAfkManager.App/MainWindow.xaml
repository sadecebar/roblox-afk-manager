<Window x:Class="RobloxAfkManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RobloxAfkManager.App.Controls"
        Title="Roblox AFK Manager" Icon="/RobloxAfkManager;component/Assets/RobloxAfkManager.ico" Width="1200" Height="800" MinWidth="640" MinHeight="360" WindowState="Maximized"
        Background="{StaticResource CanvasBrush}" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}" FontSize="12"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" Typography.NumeralAlignment="Tabular">
  <Grid x:Name="WorkspaceRoot" Background="{StaticResource CanvasBrush}" SizeChanged="WorkspaceRoot_SizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="28" /></Grid.RowDefinitions>

    <!-- Header: identity, fleet health, panels -->
    <Border Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,11,0" ToolTip="Roblox AFK Manager">
            <TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" FontSize="15" Foreground="{StaticResource OnAccentBrush}" />
          </Border>
          <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold">
            <Run Text="Roblox" Foreground="{StaticResource MutedBrush}" /><Run Text=" AFK" Foreground="{StaticResource AccentBrush}" /><Run Text=" Manager" />
          </TextBlock>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,12,0" Style="{StaticResource ShellDetail}">
          <Border Style="{StaticResource Chip}" Height="24" Padding="10,0" ToolTip="Clients with a disconnect report, possible stuck join, minimized or unresponsive window, and recently used accounts that are no longer running">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /><Style.Triggers>
                <DataTrigger Binding="{Binding HealthTone}" Value="Warn"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthTone}" Value="Alert"><Setter Property="Fill" Value="{StaticResource AlertBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthTone}" Value="Idle"><Setter Property="Fill" Value="{StaticResource SubtleBrush}" /></DataTrigger>
              </Style.Triggers></Style></Ellipse.Style></Ellipse>
              <TextBlock Text="{Binding HealthSummary}" VerticalAlignment="Center" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Style.Triggers>
                <DataTrigger Binding="{Binding HealthTone}" Value="Warn"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HealthTone}" Value="Alert"><Setter Property="Foreground" Value="{StaticResource AlertBrush}" /></DataTrigger>
              </Style.Triggers></Style></TextBlock.Style></TextBlock>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Chip}" Height="24" Padding="10,0" Margin="6,0,0,0" ToolTip="Clients whose matched log reports a completed join">
            <TextBlock VerticalAlignment="Center"><Run Text="{Binding JoinedCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" joined" Foreground="{StaticResource MutedBrush}" /></TextBlock>
          </Border>
          <Border Style="{StaticResource Chip}" Height="24" Padding="10,0" Margin="6,0,0,0" ToolTip="Combined working set of all detected clients, including ignored clients">
            <TextBlock VerticalAlignment="Center"><Run Text="{Binding TotalMemory, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" RAM" Foreground="{StaticResource MutedBrush}" /></TextBlock>
          </Border>
          <Button x:Name="AwayChip" Click="AwayChip_Click" Style="{StaticResource ToolbarButton}" MinHeight="24" Height="24" Padding="10,0" Margin="6,0,0,0" ToolTip="{Binding AwayHint}" AutomationProperties.Name="{Binding AwayLabel, StringFormat=Discord alerts mode: {0}}" >
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE708;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" />
              <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SubtleBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsAway}" Value="True"><Setter Property="Fill" Value="{StaticResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding SleepMode}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
              <TextBlock Text="{Binding AwayLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource ShellDetail}" />
            </StackPanel>
          </Button>
          <Button x:Name="AlertsChip" Click="AlertsChip_Click" Style="{StaticResource ToolbarButton}" MinHeight="24" Height="24" Padding="10,0" Margin="6,0,0,0" ToolTip="{Binding AlertsHint}" AutomationProperties.Name="{Binding AlertsState, StringFormat=Discord alerts: {0}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE7E7;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" />
              <TextBlock Text="{Binding AlertsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource ShellDetail}" />
              <Ellipse Style="{StaticResource StateDot}" Tag="{Binding AlertsState}" Margin="7,0,0,0" />
            </StackPanel>
          </Button>
          <Button x:Name="ReopenChip" Click="ReopenChip_Click" Style="{StaticResource ToolbarButton}" MinHeight="24" Height="24" Padding="10,0" Margin="6,0,0,0" ToolTip="{Binding ReopenHint}" AutomationProperties.Name="{Binding ReopenState, StringFormat=Automatic rejoin: {0}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" />
              <TextBlock Text="{Binding ReopenLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Style="{StaticResource ShellDetail}" />
              <Ellipse Style="{StaticResource StateDot}" Tag="{Binding ReopenState}" Margin="7,0,0,0" />
            </StackPanel>
          </Button>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="ActivityButton" Click="ActivityButton_Click" Style="{StaticResource ToolbarButton}" ToolTip="Session alerts and recent history" AutomationProperties.Name="{Binding ActivityLabel}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Activity" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource ShellDetail}" />
              <Border Style="{StaticResource CountBadge}" Background="{StaticResource AlertBrush}" Visibility="{Binding HasUnreadAlerts, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding UnreadAlerts}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="OfflineButton" Click="OfflineButton_Click" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" ToolTip="Accounts that ran in the last 24 hours but are closed now" AutomationProperties.Name="Offline accounts">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Offline" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource ShellDetail}" />
              <Border Style="{StaticResource CountBadge}" Background="{StaticResource WarningBrush}" Visibility="{Binding HasOffline, Converter={StaticResource BoolVisibility}}">
                <TextBlock Text="{Binding OfflineCount}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="IgnoredButton" Click="IgnoredButton_Click" IsEnabled="{Binding IsIdle}" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" ToolTip="Show ignored clients" AutomationProperties.Name="{Binding IgnoredMenuLabel}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xED1A;" Style="{StaticResource Glyph}" />
              <TextBlock Text="Ignored" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource ShellDetail}" />
              <Border Style="{StaticResource CountBadge}"><TextBlock Text="{Binding IgnoredCount}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            </StackPanel>
          </Button>
          <Button x:Name="SettingsButton" Click="SettingsButton_Click" Style="{StaticResource ToolbarButton}" Margin="2,0,0,0" ToolTip="Accounts, Discord alerts, window layout, resource plans and phone monitoring" AutomationProperties.Name="Settings">
            <StackPanel Orientation="Horizontal">
              <Grid><TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" />
                <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" Stroke="{StaticResource CanvasBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" ToolTip="Phone monitoring is on" Visibility="{Binding Remote.Running, Converter={StaticResource BoolVisibility}}" />
              </Grid>
              <TextBlock Text="Settings" VerticalAlignment="Center" Margin="8,0,0,0" Style="{StaticResource ShellDetail}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Toolbar: count, preview mode, actions -->
    <Grid Grid.Row="1" Margin="16,10,16,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock VerticalAlignment="Center" ToolTip="{Binding ClientCount, StringFormat={}{0} clients detected including ignored}">
          <Run Text="{Binding IncludedCount, Mode=OneWay}" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="SemiBold" /><Run Text=" on watch" Foreground="{StaticResource MutedBrush}" FontSize="13" />
        </TextBlock>
        <Border x:Name="PreviewModes" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="16,0,0,0" VerticalAlignment="Center" ToolTip="Fill removes preview bars by cropping the edges. Fit shows the whole window. Neither changes the game window.">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="FillModeButton" GroupName="PreviewMode" Content="Fill" IsChecked="{Binding FillPreviews}" Style="{StaticResource PreviewModeButton}" AutomationProperties.Name="Fill previews, crop edges" />
            <RadioButton x:Name="FitModeButton" GroupName="PreviewMode" Content="Fit" IsChecked="{Binding FitPreviews}" Style="{StaticResource PreviewModeButton}" AutomationProperties.Name="Fit previews, show complete windows" />
          </StackPanel>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="RefreshButton" Command="{Binding DetectCommand}" Style="{StaticResource ToolbarButton}" Margin="0,0,6,0" ToolTip="Refresh Roblox window detection" AutomationProperties.Name="Detect clients">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" Margin="0,0,8,0" /><TextBlock VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Refresh" /><Style.Triggers><DataTrigger Binding="{Binding Busy}" Value="True"><Setter Property="Text" Value="Updating…" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
        </Button>
        <Button x:Name="RestoreWindowsButton" Command="{Binding PrepareDashboardCommand}" Style="{StaticResource CompactPrimaryButton}" ToolTip="Restore minimized included clients. Existing window sizes and positions stay the same." AutomationProperties.Name="Restore minimized clients">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Restore windows" VerticalAlignment="Center" /></StackPanel>
        </Button>
      </StackPanel>
    </Grid>




    <!-- Ignored -->
    <Popup x:Name="IgnoredPopup" PlacementTarget="{Binding ElementName=IgnoredButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True"
           DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <Border Style="{StaticResource PopupSurface}" Width="350">
        <StackPanel>
          <TextBlock Text="Ignored clients" Style="{StaticResource PopupTitle}" />
          <TextBlock Text="Hidden from the dashboard, bulk actions, alerts and mobile view." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
          <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,14" Margin="0,0,0,12">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IgnoredCount}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <TextBlock Text="Nothing ignored. Use Ignore on the account you're playing to keep it out of the way." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding IgnoredClients}"><ItemsControl.ItemTemplate><DataTemplate>
              <Button Command="{Binding DataContext.UnignoreClientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" Margin="0,0,0,6" Padding="8,6" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{Binding ProcessId, StringFormat=Show ignored client PID {0}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid Width="26" Height="26" Margin="0,0,10,0">
                    <Ellipse Fill="{StaticResource HoverBrush}" />
                    <TextBlock Text="{Binding AvatarFallback}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding ProcessId, StringFormat=PID {0}}" FontSize="10" FontWeight="Normal" Foreground="{StaticResource SubtleBrush}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="Show" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" Margin="10,0,4,0" />
                </Grid>
              </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <StackPanel Visibility="{Binding HasPendingProfiles, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0">
            <TextBlock Text="{Binding PendingProfileHint}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,8" />
            <CheckBox Content="Show unidentified clients this session" IsChecked="{Binding AllowUnidentifiedClients}" Margin="0,0,0,10" ToolTip="These clients cannot yet be matched to saved ignore choices. They become visible and eligible for bulk actions." />
          </StackPanel>
          <Border Style="{StaticResource Divider}" Margin="0,8,0,12" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding ProfileSummary}" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
            <Button Grid.Column="1" Command="{Binding RestoreOriginalsCommand}" Style="{StaticResource CompactButton}" ToolTip="Restore saved placements for visible clients. Ignored clients are untouched." AutomationProperties.Name="Restore original placements"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Restore original placements" VerticalAlignment="Center" /></StackPanel></Button>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Offline accounts -->
    <Popup x:Name="OfflinePopup" PlacementTarget="{Binding ElementName=OfflineButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <Border Style="{StaticResource PopupSurface}" Width="380">
        <StackPanel>
          <TextBlock Text="Offline accounts" Style="{StaticResource PopupTitle}" />
          <TextBlock Text="Ran in the last 24 hours, closed now. Open these to get every account back." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
          <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="{Binding HasUnidentified, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding UnidentifiedHint}" Foreground="{StaticResource WarningBrush}" FontSize="11" TextWrapping="Wrap" />
          </Border>
          <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,18">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding OfflineAccounts.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
              <TextBlock Text="Everyone's here. If an account closes, it shows up in this list." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding OfflineAccounts}"><ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{StaticResource RaisedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Grid Width="30" Height="30" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Ellipse Fill="{StaticResource HoverBrush}" />
                    <TextBlock Text="{Binding AvatarFallback}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
                    <Ellipse Opacity="0.55"><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                    <Ellipse Width="10" Height="10" Fill="{StaticResource WarningBrush}" Stroke="{StaticResource RaisedBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                  </StackPanel>
                  <Button Grid.Column="2" Click="CopyOfflineName_Click" Style="{StaticResource ToolbarButton}" Width="30" MinHeight="28" Padding="0" Margin="8,0,0,0" ToolTip="Copy account name" AutomationProperties.Name="{Binding Name, StringFormat=Copy name {0}}">
                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="12" />
                  </Button>
                  <Button Grid.Column="3" Command="{Binding DataContext.ForgetOfflineCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" MinHeight="28" Padding="8,2" Margin="2,0,0,0" ToolTip="Stop listing this account until it runs again" AutomationProperties.Name="{Binding Name, StringFormat=Forget {0}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Forget" VerticalAlignment="Center" /></StackPanel></Button>
                </Grid>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
          <TextBlock Text="Ignored accounts never appear here. Forget hides an account until it runs again." Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </Popup>

    <!-- Activity -->
    <Popup x:Name="ActivityPopup" PlacementTarget="{Binding ElementName=ActivityButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <Border Style="{StaticResource PopupSurface}" Width="390">
        <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Activity" Style="{StaticResource PopupTitle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Click="ClearActivity_Click" Style="{StaticResource CompactButton}" IsEnabled="{Binding HasActivity}" AutomationProperties.Name="Clear"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Clear" VerticalAlignment="Center" /></StackPanel></Button>
          </Grid>
          <TextBlock Text="Last 100 events, stored on this PC. Ignored clients are excluded." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12" />
          <CheckBox Content="Desktop notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,14" ToolTip="Windows may hide notifications when Do not disturb is enabled. All events remain in this history." />
          <Border Background="{StaticResource InputBrush}" CornerRadius="8" Padding="12,18">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasActivity}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
              <TextBlock Text="Quiet night. No session alerts yet." Foreground="{StaticResource MutedBrush}" TextAlignment="Center" />
            </StackPanel>
          </Border>
          <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Activity}"><ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,5,0,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                <StackPanel Grid.Column="1">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding Time}" FontSize="10" Foreground="{StaticResource SubtleBrush}" Margin="10,0,0,0" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                </StackPanel>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Settings -->
    <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
      <Border Style="{StaticResource PopupSurface}" Width="460">
        <StackPanel>
          <TextBlock Text="Settings" Style="{StaticResource PopupTitle}" />
          <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="2" Margin="0,10,0,12" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="SettingsTabAccounts" GroupName="SettingsTab" IsChecked="True" Style="{StaticResource TabButton}" AutomationProperties.Name="Accounts"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE716;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" /><TextBlock Text="Accounts" VerticalAlignment="Center" /></StackPanel></RadioButton>
            <RadioButton x:Name="SettingsTabAlerts" GroupName="SettingsTab" Style="{StaticResource TabButton}" AutomationProperties.Name="Alerts"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E7;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" /><TextBlock Text="Alerts" VerticalAlignment="Center" /></StackPanel></RadioButton>
            <RadioButton x:Name="SettingsTabLayout" GroupName="SettingsTab" Style="{StaticResource TabButton}" AutomationProperties.Name="Layout"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" /><TextBlock Text="Layout" VerticalAlignment="Center" /></StackPanel></RadioButton>
            <RadioButton x:Name="SettingsTabPlans" GroupName="SettingsTab" Style="{StaticResource TabButton}" AutomationProperties.Name="Plans"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" /><TextBlock Text="Plans" VerticalAlignment="Center" /></StackPanel></RadioButton>
            <RadioButton x:Name="SettingsTabPhone" GroupName="SettingsTab" Style="{StaticResource TabButton}" AutomationProperties.Name="Phone"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" Style="{StaticResource BtnGlyph}" Margin="0,0,6,0" /><TextBlock Text="Phone" VerticalAlignment="Center" /></StackPanel></RadioButton>
            </StackPanel>
          </Border>
          <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
            <StackPanel x:Name="SettingsAccountsPanel" Style="{StaticResource TabPanel}" Visibility="{Binding IsChecked, ElementName=SettingsTabAccounts, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="Saved logins" Style="{StaticResource PopupTitle}" />
            <ItemsControl ItemsSource="{Binding SavedLogins}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
              <Grid Margin="0,0,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Include in Open selected" AutomationProperties.Name="{Binding Name, StringFormat=Select {0}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
                <Button Grid.Column="3" Command="{Binding DataContext.OpenLoginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource CompactButton}" MinHeight="26" Padding="10,2" Margin="0,0,4,0" AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Open" VerticalAlignment="Center" /></StackPanel></Button>
                <Button Grid.Column="4" Click="LoginRow_Click" Style="{StaticResource ToolbarButton}" MinHeight="26" Padding="8,2" Margin="0,0,4,0" ToolTip="Open this account's own browser profile. If its session expired, log in once; otherwise this just refreshes the saved login." AutomationProperties.Name="{Binding Name, StringFormat=Log in again as {0}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource BtnGlyph}" Margin="0" /></StackPanel></Button>
                <Button Grid.Column="5" Command="{Binding DataContext.RemoveLoginCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarButton}" MinHeight="26" Padding="8,2" AutomationProperties.Name="{Binding Name, StringFormat=Remove saved login {0}}"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource BtnGlyph}" Margin="0" /></StackPanel></Button>
              </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="Game to open (roblox.com/games/… link or place id)" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,8,0,4" />
            <TextBox Text="{Binding GameLink, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Game link or place id" />
            <CheckBox Content="When I'm away, reopen accounts that crash or get kicked" IsChecked="{Binding AutoReopen}" Margin="0,8,0,0" ToolTip="While you are away from the PC (see the Alerts tab), an account whose window closes, or that is kicked and left on the error screen, is started again from its saved login. Needs a saved login and a game. At most 3 times an hour per account and 24 an hour in total." />
          <CheckBox Content="Restart an account when Roblox ends its login" IsChecked="{Binding AutoRecover}" Margin="0,8,0,0" ToolTip="When a client's login is ended (it freezes, then gets kicked), the manager restarts just that account from its saved login. At most once per 20 minutes per account." />
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="56" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Seconds between accounts" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
              <TextBox Grid.Column="2" Text="{Binding LaunchSpacingSeconds, UpdateSourceTrigger=LostFocus}" ToolTip="5 to 120. Roblox slows launches down if too many start at once." AutomationProperties.Name="Seconds between accounts" />
            </Grid>
            <Button Command="{Binding OpenSelectedCommand}" Style="{StaticResource CompactButton}" Margin="0,8,0,0" ToolTip="Starts only the accounts you ticked above."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="{Binding OpenSelectedLabel}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Command="{Binding OpenClosedCommand}" Style="{StaticResource CompactPrimaryButton}" Margin="0,6,0,0" ToolTip="Starts the game below for every saved account that isn't running."><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="{Binding OpenClosedLabel}" VerticalAlignment="Center" /></StackPanel></Button>
            <Button Click="LoginNew_Click" Style="{StaticResource CompactButton}" Margin="0,8,0,0" ToolTip="Opens Roblox's login page. Log in once and the account is saved; no cookie copying." AutomationProperties.Name="Log in to add an account…"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8FA;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Log in to add an account…" VerticalAlignment="Center" /></StackPanel></Button>
            <TextBlock Text="A saved login gives full access to the account: don't use this on a shared PC. Or add one by pasting its .ROBLOSECURITY cookie. It is stored encrypted for this Windows user and only sent to roblox.com." Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,6" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <PasswordBox x:Name="CookieBox" AutomationProperties.Name="Session cookie" />
              <Button Grid.Column="1" Click="AddLogin_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0" AutomationProperties.Name="Add"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Add" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <Border Style="{StaticResource Divider}" Margin="0,12,0,10" />
            <StackPanel Orientation="Horizontal">
              <Button Click="Backup_Click" Style="{StaticResource CompactButton}" ToolTip="Saves names, order, ignored accounts and window positions to a file. Logins are not included." AutomationProperties.Name="Back up settings…"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Back up settings…" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Click="Restore_Click" Style="{StaticResource CompactButton}" Margin="6,0,0,0" ToolTip="Loads a settings backup made with Back up settings." AutomationProperties.Name="Restore…"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Restore…" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="SettingsAlertsPanel" Style="{StaticResource TabPanel}" Visibility="{Binding IsChecked, ElementName=SettingsTabAlerts, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="When am I away?" Style="{StaticResource PopupTitle}" FontSize="15" />
            <ComboBox SelectedIndex="{Binding AwayModeIndex}" Margin="0,8,0,0" AutomationProperties.Name="Away mode">
              <ComboBoxItem Content="Automatic: away when I haven't touched the PC for a while" />
              <ComboBoxItem Content="Sleep mode: always away, even while I use the PC" />
              <ComboBoxItem Content="Never (I'm at the PC)" />
            </ComboBox>
            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="56" /></Grid.ColumnDefinitions>
              <TextBlock Text="Count me as away after (minutes without keyboard or mouse)" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding AwayMinutes, UpdateSourceTrigger=LostFocus}" ToolTip="1 to 240" AutomationProperties.Name="Minutes until away" />
            </Grid>
            <TextBlock Text="{Binding AwayHint}" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="Discord alerts and automatic reopening only happen while you are away. At the PC nothing is sent or reopened, so closing a client yourself is always respected. When you step away, one message lists accounts that were already down." Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
            <TextBlock Text="Alerts and log channel" Style="{StaticResource PopupTitle}" FontSize="15" />
            <TextBlock Text="Get a Discord message when an account disconnects, its game or window closes, it freezes, or it loses its login, even when you're away from the PC." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
            <TextBlock Text="Webhook address for alerts, pings and the log (channel settings → Integrations → Webhooks)" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,0,0,4" />
            <PasswordBox x:Name="DiscordUrlBox" AutomationProperties.Name="Discord webhook address" />
            <TextBlock Text="Your Discord user ID (optional: this is what makes your phone ping)" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,8,0,4" />
            <TextBox x:Name="DiscordUserBox" AutomationProperties.Name="Discord user ID" MaxLength="25" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Click="SaveDiscord_Click" Style="{StaticResource CompactPrimaryButton}" AutomationProperties.Name="Save"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Save" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Command="{Binding TestDiscordCommand}" Style="{StaticResource CompactButton}" Margin="6,0,0,0" AutomationProperties.Name="Test"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE724;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Test" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Click="ClearDiscord_Click" Style="{StaticResource CompactButton}" Margin="6,0,0,0" IsEnabled="{Binding DiscordConfigured}" AutomationProperties.Name="Turn off"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Turn off" VerticalAlignment="Center" /></StackPanel></Button>
            </StackPanel>
            <TextBlock Text="{Binding DiscordSummary}" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBlock Text="Alerts contain account names and what happened, and go only to Discord. The webhook is stored encrypted on this PC. If the PC itself shuts down, no alert can be sent." Foreground="{StaticResource SubtleBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Border Style="{StaticResource Divider}" Margin="0,12,0,12" />
            <TextBlock Text="Live status board" Style="{StaticResource PopupTitle}" FontSize="15" />
            <TextBlock Text="One message that lists every account and is edited in place whenever something changes, so a channel stays quiet. Put it in its own channel, apart from the alerts." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8" />
            <CheckBox Content="Keep one live status message with every account (edited in place)" IsChecked="{Binding BoardEnabled}" Margin="0,0,0,0" ToolTip="Posts a single message listing every account and its state, and edits it whenever something changes instead of sending new messages. Turning it off deletes the message." />
            <TextBlock Text="Board channel webhook (optional: leave empty to post the board in the alerts channel)" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,4" />
            <PasswordBox x:Name="BoardUrlBox" AutomationProperties.Name="Board channel webhook address" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button Click="SaveBoardChannel_Click" Style="{StaticResource CompactPrimaryButton}" AutomationProperties.Name="Save board channel"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Save board channel" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Click="ClearBoardChannel_Click" Style="{StaticResource CompactButton}" Margin="6,0,0,0" IsEnabled="{Binding BoardHasOwnChannel}" ToolTip="Post the board in the alerts channel again" AutomationProperties.Name="Use the alerts channel for the board"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource BtnGlyph}" Margin="0" /></StackPanel></Button>
            </StackPanel>
            <TextBlock Text="{Binding BoardSummary}" Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel x:Name="SettingsLayoutPanel" Style="{StaticResource TabPanel}" Visibility="{Binding IsChecked, ElementName=SettingsTabLayout, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="Arrange windows" Style="{StaticResource PopupTitle}" />
            <TextBlock Text="Grid monitor" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Monitors}" SelectedItem="{Binding SelectedMonitor}" DisplayMemberPath="Label" AutomationProperties.Name="Grid monitor" />
            <TextBlock Text="Layout" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
            <ComboBox ItemsSource="{Binding Layouts}" SelectedItem="{Binding SelectedLayout}" DisplayMemberPath="Label" AutomationProperties.Name="Grid layout" />
            <TextBlock Text="Main client (maximized on the primary monitor)" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" TextWrapping="Wrap" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <ComboBox ItemsSource="{Binding Clients}" SelectedItem="{Binding MainClient}" DisplayMemberPath="Label" AutomationProperties.Name="Main client" />
              <Button Grid.Column="1" Click="ClearMain_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0" AutomationProperties.Name="None"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="None" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <TextBlock Text="{Binding MainSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,8,0,14" />
            <Button Command="{Binding ArrangeCommand}" Click="ArrangeNow_Click" Style="{StaticResource CompactPrimaryButton}" AutomationProperties.Name="Arrange now"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80A;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Arrange now" VerticalAlignment="Center" /></StackPanel></Button>
            <Border Style="{StaticResource Divider}" Margin="0,14,0,12" />
            <TextBlock Text="Remember positions" Foreground="{StaticResource MutedBrush}" />
            <TextBlock Text="Put the windows where you want them, then save. Each account opens in its own spot from now on." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,4,0,8" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button Command="{Binding SaveLayoutCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Save current positions"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE718;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Save current positions" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="1" Command="{Binding ClearLayoutCommand}" Style="{StaticResource CompactButton}" Margin="8,0,0,0" AutomationProperties.Name="Clear"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE711;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Clear" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <TextBlock Text="{Binding LayoutSummary2}" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" />
            </StackPanel>
            <StackPanel x:Name="SettingsPlansPanel" Style="{StaticResource TabPanel}" Visibility="{Binding IsChecked, ElementName=SettingsTabPlans, Converter={StaticResource BoolVisibility}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Performance" Style="{StaticResource PopupTitle}" />
              <Border Grid.Column="1" Style="{StaticResource Chip}" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"><TextBlock Text="{Binding ResourcePlanSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" /></Border>
            </Grid>
            <TextBlock Text="Windows priority for every included client, including new arrivals. Ignored clients keep their original settings." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
            <TextBlock Text="PLAN" Style="{StaticResource Overline}" />
            <ComboBox ItemsSource="{Binding ResourcePlans}" SelectedItem="{Binding SelectedResourcePlan}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Resource plan" />
            <TextBlock Text="{Binding ResourcePlanDescription}" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap" Margin="0,10,0,6" />
            <TextBlock Text="Plans adjust Windows priorities. They do not set FPS or limit RAM." Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button Command="{Binding ApplyResourcePlanCommand}" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Apply to visible clients"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Apply to visible clients" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="1" Command="{Binding ResetResourcePlanCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Reset all"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Reset all" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <Border Style="{StaticResource Divider}" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Resident RAM limit" Style="{StaticResource SectionHeading}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding MemoryCapSummary}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
            <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="8" Padding="10,8" Margin="0,10,0,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,9,0" />
                <TextBlock Grid.Column="1" Text="Limits physical working-set RAM, not total allocated memory. 500 MiB can cause heavy paging, stutters or slow rejoins. Ignored clients stay exempt." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" FontSize="11" />
              </Grid>
            </Border>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBox Text="{Binding MemoryCapInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsIdle}" MinHeight="32" Padding="8,4" FontFamily="{StaticResource MonoFont}" ToolTip="256–8192 MiB per included client" AutomationProperties.Name="Resident RAM limit in MiB" />
              <TextBlock Grid.Column="1" Text="MiB" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="6,0,10,0" />
              <Button Grid.Column="2" Command="{Binding ApplyMemoryCapCommand}" Style="{StaticResource CompactButton}" Margin="0,0,8,0" AutomationProperties.Name="Apply limit"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73E;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Apply limit" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="3" Command="{Binding ResetMemoryCapCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Off"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7E8;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Off" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <TextBlock Text="Original settings come back when the manager closes normally." Foreground="{StaticResource SubtleBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
            <StackPanel x:Name="SettingsPhonePanel" Style="{StaticResource TabPanel}" DataContext="{Binding Remote}" Visibility="{Binding IsChecked, ElementName=SettingsTabPhone, Converter={StaticResource BoolVisibility}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="Mobile monitoring" Style="{StaticResource PopupTitle}" />
              <Border Grid.Column="1" CornerRadius="10" Padding="9,2" VerticalAlignment="Center">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource IdleSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="Off" /><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Text" Value="Live" /><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
              </Border>
            </Grid>
            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />
            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button Command="{Binding StartCommand}" Style="{StaticResource CompactPrimaryButton}" Margin="0,0,8,0" AutomationProperties.Name="Start monitoring"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Start monitoring" VerticalAlignment="Center" /></StackPanel></Button>
              <Button Grid.Column="1" Command="{Binding StopCommand}" Style="{StaticResource CompactButton}" AutomationProperties.Name="Stop"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE71A;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Stop" VerticalAlignment="Center" /></StackPanel></Button>
            </Grid>
            <StackPanel Visibility="{Binding Running, Converter={StaticResource BoolVisibility}}" Margin="0,16,0,0">
              <TextBlock Text="ACCESS CODE · CHANGES EACH START" Style="{StaticResource Overline}" />
              <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding AccessCode, Mode=OneWay}" Style="{StaticResource CodeBox}" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap" AutomationProperties.Name="Dashboard access code" />
                <Button Grid.Column="1" Click="CopyMobileCode_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0" ToolTip="Copy access code" AutomationProperties.Name="Copy access code">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,6,0" /><TextBlock Text="Copy" VerticalAlignment="Center" /></StackPanel>
                </Button>
              </Grid>
              <TextBlock Text="LOCAL TEST ADDRESS" Style="{StaticResource Overline}" Margin="0,12,0,6" />
              <TextBox Text="{Binding LocalAddress, Mode=OneWay}" Style="{StaticResource CodeBox}" AutomationProperties.Name="Local monitoring address" />
            </StackPanel>
            <Border Style="{StaticResource Divider}" />
            <TextBlock Text="AWAY FROM HOME" Style="{StaticResource Overline}" Margin="0,0,0,10" />
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" Text="Install Tailscale on this PC and on your phone, signed in to the same account." TextWrapping="Wrap" Margin="0,2,0,0" />
            </Grid>
            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="Run this on the PC:" Margin="0,2,0,6" />
                <TextBox Text="tailscale serve --bg http://127.0.0.1:8765" Style="{StaticResource CodeBox}" TextWrapping="Wrap" AutomationProperties.Name="Tailscale Serve command" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition /></Grid.ColumnDefinitions>
              <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Top"><TextBlock Text="3" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
              <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="Open the HTTPS address Tailscale prints and enter the access code. Use private Serve, never public Funnel." /><Run Text=" Details: docs/REMOTE.md." Foreground="{StaticResource MutedBrush}" /></TextBlock>
            </Grid>
            <TextBlock Text="Read-only. Ignored clients stay hidden. Previews refresh about every 8 seconds while viewed and never move or restore a game. A locked desktop or minimized window can block previews." Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" FontSize="11" />
            </StackPanel>
            </Grid>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Account name editor -->
    <Popup x:Name="NamePopup" Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" DataContext="{x:Null}">
      <Border Style="{StaticResource PopupSurface}" Width="330">
        <StackPanel>
          <TextBlock Text="Account name" Style="{StaticResource PopupTitle}" FontSize="16" />
          <TextBlock Text="{Binding ClientDetails}" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="0,4,0,12" />
          <TextBox x:Name="ClientNameInput" MaxLength="64" KeyDown="ClientNameInput_KeyDown" AutomationProperties.Name="Account name" />
          <TextBlock Text="{Binding NameHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0" />
          <TextBlock Text="{Binding ProfileHint}" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
          <TextBlock x:Name="ClientNameError" Foreground="{StaticResource AlertBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
          <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Click="AutomaticClientName_Click" Style="{StaticResource CompactButton}" Margin="0,0,8,0" AutomationProperties.Name="Use automatic name"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Use automatic name" VerticalAlignment="Center" /></StackPanel></Button>
            <Button x:Name="SaveClientNameButton" Grid.Column="1" Click="SaveClientName_Click" Style="{StaticResource CompactPrimaryButton}" MinWidth="72" AutomationProperties.Name="Save"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Save" VerticalAlignment="Center" /></StackPanel></Button>
          </Grid>
        </StackPanel>
      </Border>
    </Popup>

    <!-- Client workspace -->
    <ListBox x:Name="ClientDashboard" Grid.Row="2" Margin="16,0,16,12" ItemsSource="{Binding VisibleClients}" SelectedItem="{Binding SelectedClient}" Background="Transparent" BorderThickness="0" Padding="0"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ClipToBounds="True" AutomationProperties.Name="Live Roblox client workspace"
             AllowDrop="True" PreviewMouseLeftButtonDown="Dashboard_MouseDown" PreviewMouseMove="Dashboard_MouseMove" PreviewMouseLeftButtonUp="Dashboard_MouseUp"
             DragOver="Dashboard_DragOver" DragLeave="Dashboard_DragLeave" Drop="Dashboard_Drop" PreviewKeyDown="Dashboard_KeyDown">
      <ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ItemsPresenter /></Border></ControlTemplate></ListBox.Template>
      <ListBox.ItemsPanel><ItemsPanelTemplate><controls:CompactDashboardPanel PreviewAspectRatio="{Binding DashboardPreviewAspectRatio}" ClipToBounds="True" /></ItemsPanelTemplate></ListBox.ItemsPanel>
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="ClipToBounds" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusOutline}" /><Setter Property="AutomationProperties.Name" Value="{Binding Label, StringFormat=Roblox client {0}}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Tile" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" /></Border>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding StatusTone}" Value="Warn"><Setter TargetName="Tile" Property="BorderBrush" Value="#59F4BA5E" /></DataTrigger>
            <DataTrigger Binding="{Binding StatusTone}" Value="Alert"><Setter TargetName="Tile" Property="BorderBrush" Value="#80FF7470" /><Setter TargetName="Tile" Property="Background" Value="{StaticResource AlertTileBrush}" /></DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" /></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            <Trigger Property="controls:WorkspaceAppearance.IsDropTarget" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /><Setter TargetName="Tile" Property="Background" Value="#1C1A2E" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate>
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Button Style="{StaticResource PreviewButton}" Margin="4,4,4,0" Command="{Binding DataContext.FocusClientCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label, StringFormat=Open Roblox client {0}}">
            <Button.ToolTip><StackPanel MaxWidth="320">
              <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13" /><TextBlock Text="{Binding ClientDetails}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
              <TextBlock Text="{Binding HeadlineStatus}" FontWeight="SemiBold" Style="{StaticResource StatusInk}" />
              <TextBlock Text="{Binding SessionHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,6" />
              <TextBlock><Run Text="CPU " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Cpu, Mode=OneWay}" /><Run Text="   RAM " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding Memory, Mode=OneWay}" /></TextBlock>
              <TextBlock Text="{Binding Status, StringFormat=Window: {0}}" /><TextBlock Text="{Binding Position, StringFormat=Bounds: {0}}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding ResourceStatus}" Foreground="{StaticResource MutedBrush}" />
              <TextBlock Text="{Binding NameHint}" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" Margin="0,6,0,0" /><TextBlock Text="{Binding ProfileHint}" TextWrapping="Wrap" Foreground="{StaticResource SubtleBrush}" />
            </StackPanel></Button.ToolTip>
            <controls:LiveWindowPreview Identity="{Binding Identity}" CanPreview="{Binding CanPreview}" SourceBounds="{Binding WindowBounds}" RefreshRevision="{Binding PreviewRevision}" FillPreview="{Binding DataContext.FillPreviews, RelativeSource={RelativeSource AncestorType=ListBox}}" IdentityValidator="{Binding DataContext.PreviewValidator, RelativeSource={RelativeSource AncestorType=ListBox}}" IsHitTestVisible="False" />
          </Button>
          <Grid Grid.Row="1">
            <Grid.Style><Style TargetType="Grid">
              <Setter Property="Margin" Value="10,7,10,8" />
              <Style.Triggers><Trigger Property="controls:CompactDashboardPanel.IsDense" Value="True"><Setter Property="Margin" Value="5,2,5,4" /></Trigger></Style.Triggers>
            </Style></Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

            <!-- Identity + drag handle -->
            <Grid x:Name="ClientDragHandle" Background="Transparent" Cursor="SizeAll" ToolTip="Drag onto another client to swap positions. Ctrl+Left/Right swaps with the previous/next client.">
              <Grid.Style><Style TargetType="Grid"><Setter Property="Height" Value="36" /><Style.Triggers><Trigger Property="controls:CompactDashboardPanel.IsDense" Value="True"><Setter Property="Height" Value="20" /></Trigger></Style.Triggers></Style></Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Grid Width="34" Height="34" Margin="0,0,9,0" Style="{StaticResource CardDetail}" ToolTip="{Binding HeadlineStatus}">
                <Ellipse Width="32" Height="32" Fill="{StaticResource HoverBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <TextBlock Text="{Binding AvatarFallback}" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top" TextAlignment="Center" Padding="0,8,0,0" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                <Ellipse Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Top"><Ellipse.Fill><ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse>
                <Ellipse Width="11" Height="11" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource StatusDot}" />
              </Grid>
              <Border Style="{StaticResource DenseOnly}" VerticalAlignment="Center" Margin="1,0,6,0" ToolTip="{Binding HeadlineStatus}">
                <Ellipse Width="6" Height="6" Style="{StaticResource StatusDot}" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="ClientNameLabel" Text="{Binding Label}" ToolTip="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Grid Style="{StaticResource CardDetail}" ToolTip="{Binding SessionHint}" Margin="0,1,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding GameName}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{Binding SessionDuration}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="6,0,0,0" />
                </Grid>
              </StackPanel>
              <Button x:Name="EditClientNameButton" Grid.Column="2" Click="EditClientName_Click" Style="{StaticResource ToolbarButton}" Width="24" MinHeight="20" Height="24" Padding="0" Margin="4,0,0,0" ToolTip="Set account name (F2)" AutomationProperties.Name="{Binding ClientDetails, StringFormat=Set account name for {0}}">
                <TextBlock Text="&#xE70F;" Style="{StaticResource Glyph}" FontSize="11" />
              </Button>
              <Border Grid.Column="3" Background="{StaticResource RaisedBrush}" CornerRadius="5" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource CardDetail}" ToolTip="{Binding ClientDetails}">
                <TextBlock Text="{Binding Slot}" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource SubtleBrush}" />
              </Border>
            </Grid>

            <!-- Session status + plan -->
            <Grid Grid.Row="1" Margin="0,7,0,0" Style="{StaticResource CardDetail}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Border Style="{StaticResource StatusPill}" HorizontalAlignment="Left" ToolTip="{Binding SessionHint}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource StatusDot}" />
                  <TextBlock Text="{Binding HeadlineStatus}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource StatusInk}" />
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="6,0,0,0" ToolTip="{Binding ResourceStatus}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="9" Foreground="{StaticResource SubtleBrush}" Margin="0,0,5,0" />
                  <TextBlock Text="{Binding PlanLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>

            <!-- Measured resources -->
            <Grid Grid.Row="2" Height="18" Margin="0,7,0,0" Style="{StaticResource CardDetail}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontSize="11" ToolTip="Average share of total CPU capacity since the previous metadata sample. Updated about every 10 seconds; a dash means no measurement yet.">
                <Run Text="CPU " Foreground="{StaticResource SubtleBrush}" FontSize="10" /><Run Text="{Binding Cpu, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
              <ProgressBar Grid.Column="1" Value="{Binding CpuMeter, Mode=OneWay}" Style="{StaticResource CpuMeter}" Margin="8,0,12,0" MaxWidth="64" HorizontalAlignment="Stretch" VerticalAlignment="Center" IsHitTestVisible="False" />
              <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" ToolTip="Resident working-set memory">
                <Run Text="RAM " Foreground="{StaticResource SubtleBrush}" FontSize="10" /><Run Text="{Binding Memory, Mode=OneWay}" FontWeight="SemiBold" />
              </TextBlock>
            </Grid>

            <!-- Actions -->
            <Grid Grid.Row="3">
              <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers><Trigger Property="controls:CompactDashboardPanel.IsDense" Value="True"><Setter Property="Margin" Value="0,2,0,0" /></Trigger></Style.Triggers></Style></Grid.Style>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <Button x:Name="ShowClientButton" Style="{StaticResource CardAction}" Command="{Binding DataContext.FocusClientCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" ToolTip="Bring this client to the foreground" AutomationProperties.Name="{Binding Label, StringFormat=Show client {0}}">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A7;" Style="{StaticResource Glyph}" FontSize="11" /><TextBlock Text="Show" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource DenseHiddenText}" /></StackPanel>
              </Button>
              <CheckBox Grid.Column="2" Content="Ignore" IsChecked="{Binding IsIgnored}" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=ListBox}}" Style="{StaticResource IgnoreAction}" ToolTip="Hide this client and exclude it from bulk actions. Show it again from Ignored." AutomationProperties.Name="{Binding Label, StringFormat=Ignore client {0}}" />
            </Grid>
          </Grid>
        </Grid>
      </DataTemplate></ListBox.ItemTemplate>
    </ListBox>

    <!-- Empty state -->
    <StackPanel Grid.Row="2" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Visibility="{Binding IsEmpty, Converter={StaticResource BoolVisibility}}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,22">
        <Rectangle Width="64" Height="42" RadiusX="8" RadiusY="8" Stroke="{StaticResource StrongBorderBrush}" StrokeDashArray="3 3" StrokeThickness="1.5" />
        <Grid Width="84" Height="56" Margin="10,0">
          <Rectangle RadiusX="10" RadiusY="10" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.5" />
          <TextBlock Text="&#xE708;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{StaticResource AccentBrush}" />
        </Grid>
        <Rectangle Width="64" Height="42" RadiusX="8" RadiusY="8" Stroke="{StaticResource StrongBorderBrush}" StrokeDashArray="3 3" StrokeThickness="1.5" />
      </StackPanel>
      <TextBlock Text="{Binding EmptyHeading}" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,0,0,8" />
      <TextBlock Text="{Binding EmptyMessage}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="19" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
        <Button Command="{Binding DetectCommand}" Style="{StaticResource CompactPrimaryButton}" AutomationProperties.Name="Detect clients"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Detect clients" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Click="IgnoredButton_Click" Style="{StaticResource CompactButton}" Margin="8,0,0,0" Visibility="{Binding HasIgnored, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="Show ignored clients"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B3;" Style="{StaticResource BtnGlyph}" /><TextBlock Text="Show ignored clients" VerticalAlignment="Center" /></StackPanel></Button>
      </StackPanel>
    </StackPanel>

    <!-- Status bar -->
    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0" Background="{StaticResource ChromeBrush}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource SubtleBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
        <TextBlock Grid.Column="1" Text="{Binding Message}" ToolTip="{Binding Message}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Grid.Column="2" Text="{Binding LastRefresh}" Foreground="{StaticResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" ToolTip="Window events and a 10-second metadata refresh" />
        <TextBlock Grid.Column="3" Text="{Binding TotalMemory, StringFormat='  ·  {0} RAM'}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Style="{StaticResource CompactOnly}" ToolTip="Combined working set of all detected clients, including ignored clients" />
      </Grid>
    </Border>
  </Grid>
</Window>
